# Caddy sits behind the Cloudflare tunnel and fans requests out by hostname.
#
# Why HTTP and not HTTPS here: cloudflared delivers requests to Caddy over the
# Pi's internal Docker network, and TLS was already terminated at Cloudflare's
# edge. Asking Caddy to get its own Let's Encrypt cert would mean solving an
# ACME challenge for a host that isn't publicly reachable — it would fail, and
# it would buy nothing. `http://` on these site blocks disables that attempt.

{
	# Cloudflare is the only thing that ever talks to us, so its forwarded
	# header is the trustworthy source of the real visitor IP.
	servers {
		trusted_proxies static private_ranges
	}

	# The replace-response module (compiled in via caddy/Dockerfile) registers
	# its `replace` directive and self-orders it after `encode`, so the response
	# body is rewritten before gzip runs on it — no `order` line needed here.
}

# Snippet imported INSIDE a reverse_proxy block, so it may only contain
# reverse_proxy subdirectives. `encode` is a site-level directive and belongs in
# the site block below — putting it here makes Caddy reject the whole config at
# startup, which reads downstream as a 502 from Cloudflare rather than as a
# config error.
(proxyhdr) {
	# The apps are Flask behind gunicorn; these make the real client IP and
	# scheme visible so generated URLs come out as https, not http.
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-Proto https
}

# Injected into every proxied HTML page, right before </body>: one fixed-position
# link back to the launcher at the apex domain. None of the four apps carries
# this link in its own templates and they live in four separate repos, so doing
# it here keeps the "go to another app" affordance in one place — and any app
# added later gets it for free. Non-HTML responses (JSON, HTMX fragments, static
# assets) never contain </body>, so they pass through untouched.
#
# The replacement text must contain no { or } — Caddy reads those as placeholders
# even inside a backtick string — so the button is styled with an inline style
# attribute rather than a <style> block. The directive is `replace` (the
# replace-response module's name), not `replace_response`.
(homelink) {
	replace `</body>` `<a href="https://{$DOMAIN}/" aria-label="All apps" style="position:fixed;z-index:2147483647;right:14px;bottom:14px;padding:9px 14px;border-radius:999px;background:#111827;color:#fff;font:600 13px/1.1 system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;text-decoration:none;border:1px solid rgba(255,255,255,.16);box-shadow:0 3px 14px rgba(0,0,0,.32)">&#9776;&nbsp; all apps</a></body>`
}

# ---------------------------------------------------------------------------
# The launcher
# ---------------------------------------------------------------------------

# gen-kuro.com — a static page linking to every public app, and the page the
# injected "all apps" button points back to. Served straight off the
# ./caddy/site bind mount; no upstream app is involved.
http://{$DOMAIN} {
	encode gzip
	root * /srv
	file_server
}

# Send the www form to the bare domain so both work.
http://www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# ---------------------------------------------------------------------------
# The apps
# ---------------------------------------------------------------------------

http://stocks.{$DOMAIN} {
	encode gzip
	import homelink
	reverse_proxy stock-demo:8080 {
		import proxyhdr
	}
}

http://fitness.{$DOMAIN} {
	encode gzip
	import homelink
	reverse_proxy fitness-demo:8080 {
		import proxyhdr
	}
}

http://dnd.{$DOMAIN} {
	encode gzip
	import homelink
	reverse_proxy dnd:8080 {
		import proxyhdr
	}
}

# fantasy.{$DOMAIN} — the trade analyzer.
#
# The only public site behind a password. It shows real rosters and the real
# display names of nine other people, and unlike `dnd` the app has no login of
# its own, so a shared credential is what stands between the league and anyone
# who guesses the subdomain. Those names are already public on Sleeper; the
# thing worth preventing is a stranger indexing the whole league in one page.
#
# The bcrypt hash lives in .env rather than here, because this file is committed
# to a public repo and a published hash is an offline cracking target.
http://fantasy.{$DOMAIN} {
	encode gzip
	basic_auth {
		{$FFTA_AUTH_USER} {$FFTA_AUTH_HASH}
	}
	import homelink
	reverse_proxy ffta:8080 {
		import proxyhdr
	}
}

# Anything else that reaches the tunnel gets a flat 404 rather than falling
# through to whichever site happens to be listed first.
http:// {
	respond "Not found" 404
}
