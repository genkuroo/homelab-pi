# Caddy sits behind the Cloudflare tunnel and fans requests out by hostname.
#
# Why HTTP and not HTTPS here: cloudflared delivers requests to Caddy over the
# Pi's internal Docker network, and TLS was already terminated at Cloudflare's
# edge. Asking Caddy to get its own Let's Encrypt cert would mean solving an
# ACME challenge for a host that isn't publicly reachable — it would fail, and
# it would buy nothing. `http://` on these site blocks disables that attempt.

{
	# Cloudflare is the only thing that ever talks to us, so its forwarded
	# header is the trustworthy source of the real visitor IP.
	servers {
		trusted_proxies static private_ranges
	}
}

# Snippet imported INSIDE a reverse_proxy block, so it may only contain
# reverse_proxy subdirectives. `encode` is a site-level directive and belongs in
# the site block below — putting it here makes Caddy reject the whole config at
# startup, which reads downstream as a 502 from Cloudflare rather than as a
# config error.
(proxyhdr) {
	# The apps are Flask behind gunicorn; these make the real client IP and
	# scheme visible so generated URLs come out as https, not http.
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-Proto https
}

http://stocks.{$DOMAIN} {
	encode gzip
	reverse_proxy stock-demo:8080 {
		import proxyhdr
	}
}

http://fitness.{$DOMAIN} {
	encode gzip
	reverse_proxy fitness-demo:8080 {
		import proxyhdr
	}
}

http://dnd.{$DOMAIN} {
	encode gzip
	reverse_proxy dnd:8080 {
		import proxyhdr
	}
}

# fantasy.{$DOMAIN} — the trade analyzer.
#
# The only public site behind a password. It shows real rosters and the real
# display names of nine other people, and unlike `dnd` the app has no login of
# its own, so a shared credential is what stands between the league and anyone
# who guesses the subdomain. Those names are already public on Sleeper; the
# thing worth preventing is a stranger indexing the whole league in one page.
#
# The bcrypt hash lives in .env rather than here, because this file is committed
# to a public repo and a published hash is an offline cracking target.
http://fantasy.{$DOMAIN} {
	encode gzip
	basic_auth {
		{$FFTA_AUTH_USER} {$FFTA_AUTH_HASH}
	}
	reverse_proxy ffta:8080 {
		import proxyhdr
	}
}

# Anything else that reaches the tunnel gets a flat 404 rather than falling
# through to whichever site happens to be listed first.
http:// {
	respond "Not found" 404
}
