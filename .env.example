# Copy to .env on the Pi and fill in. .env is gitignored — it holds secrets.

# ---- The domain you registered at Cloudflare ----------------------------
# Everything public is served as a subdomain of this. Change it in one place
# and Caddy, cloudflared and the app configs all follow.
DOMAIN=gen-kuro.com

# ---- Timezone -----------------------------------------------------------
# IMPORTANT: Pi OS ships as UTC. The stock jobs are pegged to US market close,
# so leaving this unset would fire the "4pm" refresh at 9am Pacific.
TZ=America/Los_Angeles

# ---- Secrets ------------------------------------------------------------
# Used by stock-tracker's weekly AI TLDR (Claude Haiku 4.5).
ANTHROPIC_API_KEY=

# Token from `cloudflared tunnel token <tunnel-name>`, or leave blank if you
# run cloudflared with a credentials file instead (see cloudflared/config.yml).
CLOUDFLARE_TUNNEL_TOKEN=

# Flask session signing key for the D&D tracker. Generate once with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it logs everyone out; it must NOT be regenerated on each deploy.
DND_SECRET_KEY=
