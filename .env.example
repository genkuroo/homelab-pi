# Copy to .env on the Pi and fill in. .env is gitignored — it holds secrets.

# ---- The domain you registered at Cloudflare ----------------------------
# Everything public is served as a subdomain of this. Change it in one place
# and Caddy, cloudflared and the app configs all follow.
DOMAIN=gen-kuro.com

# ---- Timezone -----------------------------------------------------------
# IMPORTANT: Pi OS ships as UTC. The stock jobs are pegged to US market close,
# so leaving this unset would fire the "4pm" refresh at 9am Pacific.
TZ=America/Los_Angeles

# ---- Secrets ------------------------------------------------------------
# Used by stock-tracker's weekly AI TLDR (Claude Haiku 4.5).
ANTHROPIC_API_KEY=

# Token from `cloudflared tunnel token <tunnel-name>`, or leave blank if you
# run cloudflared with a credentials file instead (see cloudflared/config.yml).
CLOUDFLARE_TUNNEL_TOKEN=

# Flask session signing key for the D&D tracker. Generate once with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it logs everyone out; it must NOT be regenerated on each deploy.
DND_SECRET_KEY=

# ---- Sleeper → Discord bot ---------------------------------------------
# Bot token from discord.com/developers/applications → Bot → Reset Token.
# Treat like a password: it lets anyone act as the bot in your server.
DISCORD_TOKEN=

# Server and channel ids. Enable Developer Mode in Discord (Settings →
# Advanced), then right-click the server / the channel → Copy ID.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# The long number in sleeper.com/leagues/<THIS>/team, or run:
#   python3 ../sleeper-discord-bot/scripts/find_league_id.py <username>
SLEEPER_LEAGUE_ID=

# Optional. Failed waiver claims are noisy on a contested player, so they are
# suppressed unless you set this to 1.
SLEEPER_POLL_SECONDS=300
SLEEPER_ALERT_FAILED_WAIVERS=0

# ---- Fantasy football trade analyzer ------------------------------------
# Which Sleeper leagues to track, as `id:label` pairs separated by commas.
# The label only affects log output. Find ids with:
#   python3 ../ff-trade-analyzer/cli.py discover <sleeper-username>
FFTA_LEAGUES=

# ---- Off-site backup to Cloudflare R2 -----------------------------------
# Optional. Without these the nightly R2 job skips cleanly.
#
# Only the ff-trade-analyzer database is uploaded. Its daily market-value
# snapshots are the one thing in the stack that cannot be re-fetched from
# anywhere if the SD card dies. The fitness and stock databases hold real
# personal data and deliberately stay on the Pi.
#
# Create in the Cloudflare dashboard: R2 -> Create bucket, then
# R2 -> Manage R2 API Tokens -> Create API token (Object Read & Write,
# scoped to this one bucket). That screen shows the account id and both keys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Folder inside the bucket. Change only if you share the bucket with something else.
R2_PREFIX=ffta

# ---- Public fantasy site (fantasy.$DOMAIN) ------------------------------
# The trade analyzer is the one public site behind a password: it shows real
# rosters and nine other people's display names, and the app has no login.
#
# Generate the hash with:
#   docker compose exec caddy caddy hash-password --plaintext '<password>'
#
# IMPORTANT: double every `$` in the hash below. Compose interpolates values
# read from .env, so a raw bcrypt hash has its `$`-delimited fields eaten as
# undefined variables and reaches Caddy corrupted — which shows up as a silent
# 401, not as an error. `$2a$14$abc...` must be written `$$2a$$14$$abc...`.
FFTA_AUTH_USER=moneyhole
FFTA_AUTH_HASH=
